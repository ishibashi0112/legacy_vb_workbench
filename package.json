{
  "name": "legacy-vb-net-workbench",
  "displayName": "Legacy VB.NET Workbench",
  "description": "レガシー VB.NET(VS2013 時代の .vbproj / .sln)の論理構造を VS Code で表示・編集しやすくする補助ツール",
  "version": "0.6.0",
  "publisher": "ishibashi0112",
  "repository": {
    "type": "git",
    "url": "https://github.com/ishibashi0112/legacy_vb_workbench.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "legacyVbWorkbench.selectSolution",
        "title": "Legacy VB: Select Solution",
        "icon": "$(folder-library)"
      },
      {
        "command": "legacyVbWorkbench.selectProject",
        "title": "Legacy VB: Select VB Project",
        "icon": "$(folder-opened)"
      },
      {
        "command": "legacyVbWorkbench.refresh",
        "title": "Legacy VB: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "legacyVbWorkbench.openFile",
        "title": "Legacy VB: Open File"
      },
      {
        "command": "legacyVbWorkbench.buildSolution",
        "title": "Legacy VB: Build",
        "icon": "$(tools)"
      },
      {
        "command": "legacyVbWorkbench.openInVisualStudio",
        "title": "Legacy VB: Open in Visual Studio"
      },
      {
        "command": "legacyVbWorkbench.exportRepomix",
        "title": "Legacy VB: Export for AI (Repomix)"
      }
    ],
    "configuration": {
      "title": "Legacy VB Workbench",
      "properties": {
        "legacyVbWorkbench.msbuildPath": {
          "type": "string",
          "default": "",
          "description": "MSBuild.exe のフルパス。空の場合はレジストリ・既定パス(MSBuild 12.0 等)から自動検出します。"
        },
        "legacyVbWorkbench.devenvPath": {
          "type": "string",
          "default": "",
          "description": "devenv.exe(Visual Studio)のフルパス。空の場合はレジストリ・既定パス(VS2013)から自動検出します。"
        },
        "legacyVbWorkbench.buildConfiguration": {
          "type": "string",
          "default": "Debug",
          "description": "ビルドに使う Configuration(Debug / Release など)。"
        },
        "legacyVbWorkbench.msbuildOutputEncoding": {
          "type": "string",
          "enum": [
            "auto",
            "cp932",
            "utf8"
          ],
          "default": "auto",
          "description": "MSBuild 出力のエンコーディング。auto は自動判定(MSBuild 12.0 は cp932、MSBuild 17/18(VS2022/2026)は utf8 で出力するため通常は auto のままでよい)。"
        },
        "legacyVbWorkbench.exportIncludeDesignerFiles": {
          "type": "boolean",
          "default": false,
          "description": "Repomix 形式エクスポートに Designer 関連ファイル(*.Designer.vb 等)を含める。"
        },
        "legacyVbWorkbench.exportMaskCredentials": {
          "type": "boolean",
          "default": true,
          "description": "Repomix 形式エクスポートで認証情報らしき値(Password= / PWD= / User ID= / APIキー等)を [MASKED] に自動置換する。"
        },
        "legacyVbWorkbench.exportRespectGitignore": {
          "type": "boolean",
          "default": true,
          "description": "Repomix 形式エクスポートで .gitignore / .repomixignore に一致するファイルを除外する(本家 repomix と同じ挙動)。"
        },
        "legacyVbWorkbench.exportUiSummary": {
          "type": "boolean",
          "default": true,
          "description": "Repomix 形式エクスポートで、除外した *.Designer.vb からコントロール構成(名前・型・Text・入れ子)を <ui_summary> として自動埋め込みする。Designer 原文を含める設定が有効な場合は使われません。"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "legacyVbWorkbench",
          "title": "Legacy VB",
          "icon": "resources/legacy-vb.svg"
        }
      ]
    },
    "views": {
      "legacyVbWorkbench": [
        {
          "id": "legacyVbWorkbench.projects",
          "name": "VB.NET Projects"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "legacyVbWorkbench.projects",
        "contents": ".sln / .vbproj が選択されていません。\n[Select Solution](command:legacyVbWorkbench.selectSolution)\n[Select VB Project](command:legacyVbWorkbench.selectProject)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "legacyVbWorkbench.selectSolution",
          "when": "view == legacyVbWorkbench.projects",
          "group": "navigation@1"
        },
        {
          "command": "legacyVbWorkbench.selectProject",
          "when": "view == legacyVbWorkbench.projects",
          "group": "navigation@2"
        },
        {
          "command": "legacyVbWorkbench.refresh",
          "when": "view == legacyVbWorkbench.projects",
          "group": "navigation@3"
        },
        {
          "command": "legacyVbWorkbench.buildSolution",
          "when": "view == legacyVbWorkbench.projects",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "legacyVbWorkbench.buildSolution",
          "when": "view == legacyVbWorkbench.projects && viewItem =~ /^(solution|project)$/",
          "group": "legacyVb@1"
        },
        {
          "command": "legacyVbWorkbench.openInVisualStudio",
          "when": "view == legacyVbWorkbench.projects && viewItem =~ /^(solution|project)$/",
          "group": "legacyVb@2"
        },
        {
          "command": "legacyVbWorkbench.exportRepomix",
          "when": "view == legacyVbWorkbench.projects && viewItem =~ /^(solution|project)$/",
          "group": "legacyVb@3"
        }
      ],
      "commandPalette": [
        {
          "command": "legacyVbWorkbench.openFile",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "package:vsix": "vsce package --no-dependencies --skip-license -o releases/"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "1.75.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1",
    "iconv-lite": "^0.7.3",
    "ignore": "^7.0.6"
  }
}
