{
  "name": "legacy-vb-net-workbench",
  "displayName": "Legacy VB.NET Workbench",
  "description": "レガシー VB.NET(VS2013 時代の .vbproj / .sln)の論理構造を VS Code で表示・編集しやすくする補助ツール",
  "version": "0.0.2",
  "publisher": "ishibashi0112",
  "repository": {
    "type": "git",
    "url": "https://github.com/ishibashi0112/legacy_vb_workbench.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "legacyVbWorkbench.selectSolution",
        "title": "Legacy VB: Select Solution",
        "icon": "$(folder-library)"
      },
      {
        "command": "legacyVbWorkbench.selectProject",
        "title": "Legacy VB: Select VB Project",
        "icon": "$(folder-opened)"
      },
      {
        "command": "legacyVbWorkbench.refresh",
        "title": "Legacy VB: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "legacyVbWorkbench.openFile",
        "title": "Legacy VB: Open File"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "legacyVbWorkbench",
          "title": "Legacy VB",
          "icon": "resources/legacy-vb.svg"
        }
      ]
    },
    "views": {
      "legacyVbWorkbench": [
        {
          "id": "legacyVbWorkbench.projects",
          "name": "VB.NET Projects"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "legacyVbWorkbench.projects",
        "contents": ".sln / .vbproj が選択されていません。\n[Select Solution](command:legacyVbWorkbench.selectSolution)\n[Select VB Project](command:legacyVbWorkbench.selectProject)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "legacyVbWorkbench.selectSolution",
          "when": "view == legacyVbWorkbench.projects",
          "group": "navigation@1"
        },
        {
          "command": "legacyVbWorkbench.selectProject",
          "when": "view == legacyVbWorkbench.projects",
          "group": "navigation@2"
        },
        {
          "command": "legacyVbWorkbench.refresh",
          "when": "view == legacyVbWorkbench.projects",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "legacyVbWorkbench.openFile",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "package:vsix": "vsce package --no-dependencies --skip-license -o releases/"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "1.75.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1"
  }
}
